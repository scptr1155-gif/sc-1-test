# ---- Firebase (istemci tarafı, gizli değil) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- GİZLİ: sadece sunucu tarafı (Vercel Environment Variables) ----
# Service account JSON dosyasının base64 hali (README'de nasıl alınacağı yazıyor)
FIREBASE_SERVICE_ACCOUNT_B64=
# Uzun rastgele bir metin (en az 32 karakter). Örn: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
APP_TOKEN_SECRET=
